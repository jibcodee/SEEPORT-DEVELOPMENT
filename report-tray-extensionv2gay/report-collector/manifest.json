{
  "manifest_version": 3,
  "name": "SEEPORT",
  "version": "1.0.0",
  "description": "Right-click anything on any tab — text, image, or link — to drop it in Seeport, then export it all together for your report.",
  "permissions": ["storage", "contextMenus", "sidePanel", "activeTab", "tabs", "scripting"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "capture-screenshot": {
      "suggested_key": { "default": "Ctrl+Shift+S", "mac": "Command+Shift+S" },
      "description": "Screenshot visible tab ke SEEPORT"
    }
  },
  "action": {
    "default_title": "Open SEEPORT",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "tesseract/tesseract.min.js",
        "tesseract/worker.min.js",
        "tesseract/tesseract-core.js",
        "tesseract/tesseract-core.wasm"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
